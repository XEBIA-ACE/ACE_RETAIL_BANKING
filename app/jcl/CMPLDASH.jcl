//CMPLDASH JOB (ACCT),'COMPILE CODASH00C',CLASS=A,MSGCLASS=X,
//             MSGLEVEL=(1,1),NOTIFY=&SYSUID
//*
//* ================================================================
//* JOB: CMPLDASH
//* PURPOSE: COMPILE AND LINK-EDIT CODASH00C FOR CICS LOAD LIBRARY
//* PROGRAM: CODASH00C (CONSOLIDATED ACCOUNT TILES DASHBOARD)
//* TASK:    TASK-027
//* DATE:    2026-03-10
//* ================================================================
//*
//JOBLIB   DD DSN=CEE.SCEERUN,DISP=SHR
//         DD DSN=CBC.SCCNCMP,DISP=SHR
//*
//* ================================================================
//* STEP 1: COMPILE CODASH00C.CBL
//* PATTERN: CBLDBMS JCL (TRANSACTION ID: 24137)
//* ================================================================
//*
//COMPILE  EXEC PGM=IGYCRCTL,REGION=0M,
//             PARM='RENT,RMODE(ANY),AMODE(31),CICS,LIST,MAP,XREF,
//             NOOFFSET,NODYNAM,NOSSRANGE,NOADV,NOTEST,
//             FLAG(I,I),FLAGSTD(MICS),NOSEQ,TERM,TRUNC(BIN)'
//*
//STEPLIB  DD DSN=IGY.V6R3M0.SIGYCOMP,DISP=SHR
//         DD DSN=CICSTS56.CICS.SDFHLOAD,DISP=SHR
//*
//SYSLIB   DD DSN=CARDDEMO.COPYLIB,DISP=SHR
//         DD DSN=CARDDEMO.CPYBMS.COPYLIB,DISP=SHR
//         DD DSN=CICSTS56.CICS.SDFHCOB,DISP=SHR
//         DD DSN=CICSTS56.CICS.SDFHMAC,DISP=SHR
//*
//SYSIN    DD DSN=CARDDEMO.SOURCE.CBL(CODASH00C),DISP=SHR
//*
//SYSLIN   DD DSN=&&OBJMOD,DISP=(NEW,PASS),
//             UNIT=SYSDA,SPACE=(TRK,(10,5)),
//             DCB=(RECFM=FB,LRECL=80,BLKSIZE=3200)
//*
//SYSPRINT DD SYSOUT=*
//SYSOUT   DD SYSOUT=*
//SYSMDECK DD SYSOUT=*
//SYSTERM  DD SYSOUT=*
//*
//SYSUT1   DD UNIT=SYSDA,SPACE=(CYL,(1,1))
//SYSUT2   DD UNIT=SYSDA,SPACE=(CYL,(1,1))
//SYSUT3   DD UNIT=SYSDA,SPACE=(CYL,(1,1))
//SYSUT4   DD UNIT=SYSDA,SPACE=(CYL,(1,1))
//SYSUT5   DD UNIT=SYSDA,SPACE=(CYL,(1,1))
//SYSUT6   DD UNIT=SYSDA,SPACE=(CYL,(1,1))
//SYSUT7   DD UNIT=SYSDA,SPACE=(CYL,(1,1))
//SYSUT8   DD UNIT=SYSDA,SPACE=(CYL,(1,1))
//SYSUT9   DD UNIT=SYSDA,SPACE=(CYL,(1,1))
//SYSUT10  DD UNIT=SYSDA,SPACE=(CYL,(1,1))
//SYSUT11  DD UNIT=SYSDA,SPACE=(CYL,(1,1))
//SYSUT12  DD UNIT=SYSDA,SPACE=(CYL,(1,1))
//SYSUT13  DD UNIT=SYSDA,SPACE=(CYL,(1,1))
//SYSUT14  DD UNIT=SYSDA,SPACE=(CYL,(1,1))
//SYSUT15  DD UNIT=SYSDA,SPACE=(CYL,(1,1))
//*
//* ================================================================
//* STEP 2: LINK-EDIT CODASH00C INTO CICS LOAD LIBRARY
//* PATTERN: CICCMP TRANSACTION (ID: 24136)
//* ================================================================
//*
//LKED     EXEC PGM=IEWL,REGION=0M,COND=(0,NE,COMPILE),
//             PARM='RENT,RMODE(ANY),AMODE(31),LIST,MAP,XREF,
//             NCAL,LET,DYNAM=DLL'
//*
//SYSLIB   DD DSN=CICSTS56.CICS.SDFHLOAD,DISP=SHR
//         DD DSN=CEE.SCEELKED,DISP=SHR
//         DD DSN=CBC.SCCNOBJ,DISP=SHR
//*
//SYSLIN   DD DSN=&&OBJMOD,DISP=(OLD,DELETE)
//         DD *
  INCLUDE SYSLIB(DFHELII)
  INCLUDE SYSLIB(DFHECI)
  NAME CODASH00C(R)
/*
//*
//SYSLMOD  DD DSN=CARDDEMO.CICS.LOADLIB(CODASH00C),DISP=SHR
//*
//SYSPRINT DD SYSOUT=*
//SYSOUT   DD SYSOUT=*
//*
//SYSUT1   DD UNIT=SYSDA,SPACE=(CYL,(1,1))
//*
//* ================================================================
//* STEP 3: VERIFY LOAD MODULE EXISTS IN CICS LOAD LIBRARY
//* ================================================================
//*
//VERIFY   EXEC PGM=IDCAMS,COND=(0,NE,LKED)
//SYSPRINT DD SYSOUT=*
//SYSIN    DD *
  LISTCAT ENTRIES(CARDDEMO.CICS.LOADLIB) ALL
/*
//*
//* ================================================================
//* STEP 4: COMPILE CODASH00 BMS MAP SET
//* GENERATES PHYSICAL MAP INTO CICS LOAD LIBRARY
//* ================================================================
//*
//BMSCOMP  EXEC PGM=ASMA90,REGION=0M,COND=(0,NE,VERIFY),
//             PARM='DECK,NOOBJECT,LINECOUNT(55)'
//*
//STEPLIB  DD DSN=CICSTS56.CICS.SDFHLOAD,DISP=SHR
//         DD DSN=SYS1.MACLIB,DISP=SHR
//*
//SYSLIB   DD DSN=CICSTS56.CICS.SDFHMAC,DISP=SHR
//         DD DSN=SYS1.MACLIB,DISP=SHR
//*
//SYSIN    DD DSN=CARDDEMO.SOURCE.BMS(CODASH00),DISP=SHR
//*
//SYSLIN   DD DSN=&&BMSOBJ,DISP=(NEW,PASS),
//             UNIT=SYSDA,SPACE=(TRK,(5,2)),
//             DCB=(RECFM=FB,LRECL=80,BLKSIZE=3200)
//*
//SYSPRINT DD SYSOUT=*
//SYSOUT   DD SYSOUT=*
//*
//SYSUT1   DD UNIT=SYSDA,SPACE=(CYL,(1,1))
//SYSUT2   DD UNIT=SYSDA,SPACE=(CYL,(1,1))
//SYSUT3   DD UNIT=SYSDA,SPACE=(CYL,(1,1))
//*
//* ================================================================
//* STEP 5: LINK-EDIT CODASH00 MAP SET INTO CICS LOAD LIBRARY
//* ================================================================
//*
//BMSLKED  EXEC PGM=IEWL,REGION=0M,COND=(0,NE,BMSCOMP),
//             PARM='RENT,RMODE(ANY),AMODE(31),LIST,MAP,XREF,NCAL'
//*
//SYSLIB   DD DSN=CICSTS56.CICS.SDFHLOAD,DISP=SHR
//         DD DSN=CEE.SCEELKED,DISP=SHR
//*
//SYSLIN   DD DSN=&&BMSOBJ,DISP=(OLD,DELETE)
//         DD *
  NAME CODASH00(R)
/*
//*
//SYSLMOD  DD DSN=CARDDEMO.CICS.LOADLIB(CODASH00),DISP=SHR
//*
//SYSPRINT DD SYSOUT=*
//SYSOUT   DD SYSOUT=*
//*
//SYSUT1   DD UNIT=SYSDA,SPACE=(CYL,(1,1))
//*
//* ================================================================
//* STEP 6: VERIFY BOTH LOAD MODULES IN CICS LOAD LIBRARY
//* CONFIRMS CODASH00C AND CODASH00 ARE ACCESSIBLE TO CICS
//* ================================================================
//*
//CHKLOAD  EXEC PGM=IDCAMS,COND=(0,NE,BMSLKED)
//SYSPRINT DD SYSOUT=*
//SYSIN    DD *
  LISTCAT ENTRIES(CARDDEMO.CICS.LOADLIB) ALL
/*
//*
//* ================================================================
//* STEP 7: NEWCOPY BOTH MODULES IN CICS (CICS MUST BE ACTIVE)
//* MAKES LOAD MODULES ACCESSIBLE TO RUNNING CICS REGION
//* ================================================================
//*
//NEWCOPY  EXEC PGM=DFHCSDUP,REGION=0M,COND=(0,NE,CHKLOAD),
//             PARM='CSD(READWRITE),PAGESIZE(60),NOCOMPAT'
//*
//STEPLIB  DD DSN=CICSTS56.CICS.SDFHLOAD,DISP=SHR
//*
//DFHCSD   DD DSN=CARDDEMO.DFHCSD,DISP=SHR
//*
//SYSPRINT DD SYSOUT=*
//SYSIN    DD *
  DEFINE TRANSACTION(CD00)
         GROUP(CARDDEMO)
         PROGRAM(CODASH00C)
         TWASIZE(0)
         PROFILE(DFHCICST)
         STATUS(ENABLED)
         DESCRIPTION(CONSOLIDATED ACCOUNT TILES DASHBOARD)

  DEFINE MAPSET(CODASH00)
         GROUP(CARDDEMO)
         RESIDENT(NO)
         STATUS(ENABLED)
         DESCRIPTION(CODASH00 BMS MAP SET FOR DASHBOARD)

  DEFINE PROGRAM(CODASH00C)
         GROUP(CARDDEMO)
         LANGUAGE(COBOL)
         RELOAD(NO)
         RESIDENT(NO)
         USAGE(NORMAL)
         STATUS(ENABLED)
         DESCRIPTION(CONSOLIDATED ACCOUNT TILES DASHBOARD CONTROLLER)
/*
//*
//         IF (NEWCOPY.RC = 0) THEN
//*
//INSTALL  EXEC PGM=DFHCSDUP,REGION=0M,
//             PARM='CSD(READWRITE),PAGESIZE(60),NOCOMPAT'
//*
//STEPLIB  DD DSN=CICSTS56.CICS.SDFHLOAD,DISP=SHR
//*
//DFHCSD   DD DSN=CARDDEMO.DFHCSD,DISP=SHR
//*
//SYSPRINT DD SYSOUT=*
//SYSIN    DD *
  INSTALL GROUP(CARDDEMO)
/*
//*
//         ENDIF
//*
//         IF (COMPILE.RC > 0) THEN
//*
//COMPERR  EXEC PGM=IEFBR14
//* *** COMPILE STEP FAILED - REVIEW SYSPRINT FROM COMPILE STEP ***
//* *** CHECK FOR VIOLATIONS OF RULES:                          ***
//* ***   8162 - CICS RETURN CODE NOT CHECKED                   ***
//* ***   8034 - WS VARIABLES NOT INITIALIZED                   ***
//* ***   7688 - MOVE TRUNCATION                                 ***
//* ***   8478 - BUFFER OVERRUNS IN LOOPS                       ***
//* ***   7756 - READ WITHOUT AT END/INVALID KEY                 ***
//*
//         ENDIF
//*
//         IF (LKED.RC > 0) THEN
//*
//LKEDERR  EXEC PGM=IEFBR14
//* *** LINK-EDIT STEP FAILED - REVIEW SYSPRINT FROM LKED STEP ***
//*
//         ENDIF
//*
//