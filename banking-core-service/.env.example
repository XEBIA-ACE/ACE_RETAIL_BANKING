# Copy to .env and fill in real values. Never commit real secrets.
DB_URL=jdbc:mysql://localhost:3306/banking_core?useSSL=false&serverTimezone=UTC
DB_USERNAME=banking
DB_PASSWORD=
# HS256 signing secret shared with the identity provider; must be at least 32 bytes.
JWT_SECRET=
SERVER_PORT=8080
# US-028 notification history
NOTIFICATION_HISTORY_RETENTION=90d
NOTIFICATION_HISTORY_DEFAULT_TZ=Europe/Zurich
NOTIFICATION_HISTORY_PURGE_CRON=0 30 2 * * *
