# ─── Server ───────────────────────────────────────────────────────────────────
SERVER_PORT=8080

# ─── Database ─────────────────────────────────────────────────────────────────
DB_URL=jdbc:mysql://localhost:3306/banking_core?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
DB_USERNAME=banking_user
DB_PASSWORD=change_me_in_production
DB_POOL_SIZE=10

# ─── JPA / Hibernate ──────────────────────────────────────────────────────────
# Options: validate | update | create | create-drop
# Use 'validate' in production (Flyway manages schema)
JPA_SHOW_SQL=false
HIBERNATE_LOG_LEVEL=WARN

# ─── Logging ──────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
